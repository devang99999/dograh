# Copy to scripts/antoc_voice.env (gitignored) and fill in.

# Your self-hosted Dograh (VM), not app.dograh.com
DOGRAH_BASE_URL=https://34-14-214-236.sslip.io

# Dograh UI → Developers → create API key (starts with dg_)
