# Copy to scripts/antoc_voice.env (gitignored) and fill in.

# Your self-hosted Dograh (VM), not app.dograh.com
DOGRAH_BASE_URL=https://34-14-214-236.sslip.io

# Dograh UI → Developers → create API key (starts with dg_)
DOGRAH_API_KEY=dg_REPLACE_ME

# Inbound receptionist (do not use this for outbound campaigns)
DOGRAH_WORKFLOW_ID=3

# Dedicated outbound sales agent (from scripts/create_antoc_outbound_agent.py)
DOGRAH_OUTBOUND_WORKFLOW_ID=
DOGRAH_OUTBOUND_WORKFLOW_UUID=
DOGRAH_OUTBOUND_TRIGGER_UUID=

# Antoc CRM (already live)
ANTOC_BASE_URL=https://testapi.antoc.ai
ANTOC_VOICE_SECRET=REPLACE_WITH_VOICE_AGENT_SECRET

# Optional: Hindi TTS/STT (Sarvam Bulbul Anushka)
SARVAM_API_KEY=REPLACE_WITH_SARVAM_KEY
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
